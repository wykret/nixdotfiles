### --- AUTOSTART ---

output eDP-1 {
    mode 1366x768@60Hz
    position 0 0
    scale 1
}
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
}
input type:keyboard {
    xkb_layout br
    xkb_variant abnt2
}
exec_always systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
# Kill previous instances (important when reloading config)
exec_always pkill swaybg

# HDMI-A-2 -> fill (no repetition, no distortion)
exec_always swaybg -o HDMI-A-2 \
  -i ~/.dotfiles/wallpapers/27-upscale-upscale.png \
  -m fill

# eDP-1 -> tile (repeating pattern behavior)
exec_always swaybg -o eDP-1 \
  -i ~/.dotfiles/wallpapers/27-upscale.png \
  -m tile
exec_always --no-startup-id udiskie

# Picom REMOVIDO (Sway já é compositor)

# Dunst pode funcionar via XWayland, mas mantive:
exec_always swaync

exec ~/.config/scripts/autostart.sh
exec swayidle -w \
    timeout 300 'hyprlock' \
    on-lid 'hyprlock'

set $mod Mod4

font pango:monospace 8

for_window [app_id=".*"] border pixel 2
default_border pixel 1
#hide_edge_borders smart


# class/app_id adaptado para sway
client.focused  #2f4f3f #1f3a2e #e6f2ec #6ecf8b #1f3a2e
client.unfocused        #333333 #222222 #888888 #292929   #222222

gaps inner 5
#smart_gaps on
blur_passes 4
blur_radius 4
corner_radius 5
default_dim_inactive 0.3
blur enable
for_window [app_id="kitty"] blur disable
layer_effects "*" blur enable
blur_noise 0.02
blur_brightness 1.0
blur_contrast 1.0
# dex ambiente sway
exec dex --autostart --environment sway

# Substitui xss-lock + i3lock
exec swayidle -w \
 timeout 600 'hyprlock' \
 timeout 900 'swaymsg "output * dpms off"' \
 resume 'swaymsg "output * dpms on"' \
 before-sleep 'hyprlock'

exec nm-applet

# Atualização de status (se continuar com i3blocks)
set $refresh_i3status killall -SIGUSR1 i3blocks

# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Brilho
bindsym XF86MonBrightnessUp exec brightnessctl set +1%
bindsym XF86MonBrightnessDown exec brightnessctl set 1%-

floating_modifier $mod
bindsym Mod1+Tab exec rofi -show window icons -show-icons
bindsym $mod+n exec swaync-client --toggle-panel
bindsym $mod+Return exec kitty
bindsym $mod+Shift+b exec firefox
bindsym $mod+b exec pkill -SIGUSR1 waybar   

# Lock adaptado
bindsym $mod+u exec hyprlock

bindsym $mod+q kill

# Launcher (rofi mantido)
bindsym $mod+r exec rofi -show drun -show-icons

# Focus
#bindsym $mod+h focus left
#bindsym $mod+j focus down
#bindsym $mod+k focus up
#bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
# bindsym $mod+Shift+h move left
# bindsym $mod+Shift+j move down
# bindsym $mod+Shift+k move up
# bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Splits
bindsym $mod+v split v
bindsym $mod+h split h

# Layout
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
default_orientation horizontal
bindsym $mod+e layout toggle split

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+Shift+0 sticky toggle

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Substitui i3-nagbar
bindsym $mod+Shift+e exec "swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'"

bindsym $mod+Shift+x exec ~/.config/i3/scripts/powermenu.sh

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize grow width 10 px

    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Screenshots (Wayland)
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy
bindsym Print exec grim ~/Pictures/screenshot.png
bindsym Shift+Print exec grim - | wl-copy

bar {
    swaybar_command waybar
}

