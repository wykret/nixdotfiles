[volume]
command=pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | awk '{print $5}'
interval=1
signal=10

[cpu]
command=grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%.0f%%", usage}'
interval=5

[memory]
command=free -h | awk '/Mem:/ {print $3 "/" $2}'
interval=5

[battery]
command=cat /sys/class/power_supply/BAT0/capacity
interval=30

[network]
command=ip route | grep default | awk '{print $5}'
interval=10

[time]
command=date '+%H:%M %d/%m'
interval=10

