[global]
    monitor = 0
    follow = mouse
    width = 320
    height = 300
    origin = top-right
    offset = 20x20

    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8

    frame_width = 2
    corner_radius = 10

    font = JetBrainsMono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle

    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false

    idle_threshold = 120

    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 6

[urgency_critical]
    background = "#11111b"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0

