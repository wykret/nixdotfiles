{
    "height": 20,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["sway/workspaces",
      "sway/window"],
    "modules-center": ["clock",
      "custom/waybar-mpris"],
    "modules-right": ["backlight",
      "pulseaudio", 
      "battery",
      "disk#root",
      "disk#home", 
      //"network",
      "sway/language",
      "tray"],

   "sway/workspaces": {
          "disable-scroll": false,
          "format": "{icon}{name}",
          "format-icons": {
              "default": " ",
              "urgent": "!",
              "focused": "*"
          }
      },
    "sway/window": {
        "rewrite": {
            "": "sway"
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": false
    },


    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩 {essid}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "Connnected through {ifname} ({signalStrength}%)"
    },

    "sway/language": {
        "format": "󰣩 {}"
    },

    "clock": {
    "interval": 5,
    "format": "󰥔 {:%H:%M 󰃭 %a %d/%m}",
    "tooltip-format": "<span size='9pt'><b>{:%B %Y}</b></span>\n<tt>{calendar}</tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
            "months": "<span color='#cba6f7'><b>{}</b></span>",
            "days": "<span color='#cdd6f4'>{}</span>",
            "weeks": "<span color='#89b4fa'><b>W{}</b></span>",
            "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
            "today": "<span background='#89b4fa' foreground='#11111b'><b>{}</b></span>"
        }
}},

    "pulseaudio": {
        "format-icons": ["󰖀", "󰕾"],
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "reverse-scrolling": false
    },

    "battery": {
        "interval": 10,
        "format-charging": "󰂄 {capacity}%",
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂂", "󰁹"]
    },
    "custom/waybar-mpris": {
    "return-type": "json",
    "exec": "waybar-mpris --position --autofocus",
    "on-click": "waybar-mpris --send toggle",
    // This option will switch between players on right click.
        "on-click-right": "waybar-mpris --send player-next",
    // The options below will switch the selected player on scroll
        // "on-scroll-up": "waybar-mpris --send player-next",
        // "on-scroll-down": "waybar-mpris --send player-prev",
    // The options below will go to next/previous track on scroll
        // "on-scroll-up": "waybar-mpris --send next",
        // "on-scroll-down": "waybar-mpris --send prev",
    "escape": true
    },
    
     "disk#root": {
        "path": "/",
        "interval": 30,
        "format": "  {used}/{total}",
        "tooltip-format": "Mount: /\nUsed: {used}\nFree: {free}\nTotal: {total}\nUsage: {percentage}%"
      },

      "disk#home": {
        "path": "/home",
        "interval": 30,
        "format": "  {used}/{total}",
        "tooltip-format": "Mount: /home\nUsed: {used}\nFree: {free}\nTotal: {total}\nUsage: {percentage}%"
      }
}
