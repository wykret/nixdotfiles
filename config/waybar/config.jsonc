{
    "height": 40,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/gentoo", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["backlight", "pulseaudio", "battery", "network", "sway/language", "tray"],

    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "󱓻",
            "default": "󱓼"
        }
    },

    "sway/window": {
        "rewrite": {
            "": "sway"
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": true
    },

    "custom/gentoo": {
        "format": "󰣨 Gentoo",
        "tooltip-format": "Am I a masochist? Yes!"
    },

    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩 {essid}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "Connnected through {ifname} ({signalStrength}%)"
    },

    "sway/language": {
        "format": "󰣩 {}"
    },

    "clock": {
        "interval": 5,
        "format": "󰥔 {:%H:%M 󰃭 %a %Y-%m-%d}"
    },

    "pulseaudio": {
        "format-icons": ["󰖀", "󰕾"],
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "reverse-scrolling": true
    },

    "battery": {
        "interval": 10,
        "format-charging": "󰂄 {capacity}%",
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂂", "󰁹"]
    }
}
